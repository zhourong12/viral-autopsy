# 爆款解剖室本地配置示例。复制为 .env 后按需填写；不要把真实密钥提交到 Git。

# 服务端口与监听地址
PORT=8793
HOST=127.0.0.1

# Claude API Key。留空时只做表格导入和规则检验（截图识别、AI 标注、AI 猜想与总结不可用）。
ANTHROPIC_API_KEY=

# 模型：默认全部使用 claude-opus-5-5。可以按环节单独换模型，例如把标注换成更便宜的模型。
VA_MODEL=claude-opus-5-5
VA_VISION_MODEL=
VA_LABEL_MODEL=
VA_REASON_MODEL=
# 思考力度：low / medium / high / xhigh / max，默认 medium
VA_EFFORT=medium

# 套餐：free（每月 1 次 AI 解剖，规则检验不限）或 pro
VA_PLAN=free

# 可选：设置后所有 /api 请求（健康检查除外）都需要 Authorization: Bearer <令牌>
VA_APP_TOKEN=

# SQLite 数据库位置
VA_DB_PATH=var/viral-autopsy.db
